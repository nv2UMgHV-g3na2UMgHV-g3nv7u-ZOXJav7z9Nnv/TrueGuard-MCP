# =====================================================================
# TrueGuard-MCP — Environment Configuration
# =====================================================================
# Copy this file to `.env` and fill in the values. Every variable is
# validated at process startup by `config.Settings` (Pydantic BaseSettings);
# invalid values abort boot with a clear, actionable error message.

# ---------------------------------------------------------------------
# TrueFoundry Gateway
# ---------------------------------------------------------------------
# The AI Gateway acts as an OpenAI-compatible proxy. Obtain the endpoint
# and API key from https://console.truefoundry.ai/settings/api-keys
TRUEFOUNDRY_GATEWAY_URL=https://gateway.truefoundry.ai
TRUEFOUNDRY_API_KEY=tfy-your-api-key-here

# The MCP Gateway enforces governance policies (budget caps, approvals).
TRUEFOUNDRY_MCP_GATEWAY_URL=https://mcp-gateway.truefoundry.ai

# ---------------------------------------------------------------------
# Model Routing
# ---------------------------------------------------------------------
# Primary model is tried first; the router falls back to FALLBACK_MODEL on
# HTTP 429, 504, or connection errors. The two must differ — the config
# validator rejects identical values.
PRIMARY_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# Cost Governance
# ---------------------------------------------------------------------
# JOB_BUDGET_USD is the *soft* threshold. When a job's accumulated LLM
# spend crosses it, the router forces all subsequent calls onto
# FALLBACK_MODEL. The hard halt threshold is 1.5 × this value — cross it
# and the job raises BudgetExceededException until a human re-authorizes.
#
# Recommended: $0.50 for demos, $5.00 for production workloads.
# Valid range: 0.01 … 100.00 (enforced at boot).
JOB_BUDGET_USD=0.50

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
# Root logger level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# The demo runner overrides this to WARNING internally.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Human-in-the-Loop
# ---------------------------------------------------------------------
# Optional Slack incoming-webhook URL. If omitted, approval cards are only
# visible via the dashboard (GET /api/v1/approval/pending).
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# HTTP endpoint that resumes paused HIGH_RISK tool calls after approval.
# Must be reachable from the agent runtime AND from whatever surface the
# approver clicks (Slack button, dashboard, curl).
APPROVAL_CALLBACK_URL=http://localhost:8000/api/v1/approval/callback
